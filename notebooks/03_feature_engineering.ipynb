import pandas as pd

# Load cleaned data

df = pd.read_csv("data/processed/sales_clean.csv")

# Convert date

df["OrderDate"] = pd.to_datetime(df["OrderDate"])

# Feature engineering

df["OrderYear"] = df["OrderDate"].dt.year

df["OrderMonth"] = df["OrderDate"].dt.month

# Profit calculation

df["Profit"] = df["SalesAmount"] - df["TotalProductCost"]

# Profit margin

df["ProfitMargin"] = df["Profit"] / df["SalesAmount"]

# Profit category

df["ProfitCategory"] = pd.cut(
    df["Profit"],
    bins=[-1000, 0, 100, 500, 100000],
    labels=["Loss", "Low", "Medium", "High"]
)

# Save dataset

df.to_csv("data/processed/sales_featured.csv", index=False)

print("Feature engineering completed")